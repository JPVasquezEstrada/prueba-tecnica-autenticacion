@model PruebaTecnicaAuth.Models.Usuario
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mi perfil — Enchúfate</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/perfil.css" rel="stylesheet" />
</head>
<body>
    <div class="perfil-navbar">
        <div class="brand"><i class="bi bi-cloud-fill"></i> <span class="d-none d-md-inline">enchúfate</span></div>

        <div class="d-flex align-items-center gap-3">
            <!-- Versión PC (sin cambios) -->
            <span class="d-none d-md-inline">@Model.Nombre @Model.PrimerApellido</span>
            <a asp-action="Logout" asp-controller="Account" class="d-none d-md-inline">Cerrar sesión</a>

            <!-- Versión móvil -->
            <span class="d-inline d-md-none usuario-nombre-mobile">@Model.Nombre.Split(' ')[0] @Model.PrimerApellido @Model.SegundoApellido</span>
            <a asp-action="Logout" asp-controller="Account" class="btn-logout-icon d-flex d-md-none" title="Cerrar sesión">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>

    <div class="perfil-container">
        <div class="perfil-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h2>@Model.Nombre @Model.PrimerApellido @Model.SegundoApellido</h2>
                    <p class="subtitle">@Model.UserName · <span class="badge bg-success">Activo</span></p>
                </div>
                <a asp-action="Editar" class="btn btn-primary"><i class="bi bi-pencil-square"></i> Editar</a>
            </div>

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success">@TempData["Mensaje"]</div>
            }

            <div class="row mt-3">
                <div class="col-md-6 perfil-field mb-3">
                    <label>Nombres</label>
                    <div class="valor">@Model.Nombre</div>
                </div>
                <div class="col-md-6 perfil-field mb-3">
                    <label>Primer apellido</label>
                    <div class="valor">@Model.PrimerApellido</div>
                </div>
                <div class="col-md-6 perfil-field mb-3">
                    <label>Segundo apellido</label>
                    <div class="valor">@Model.SegundoApellido</div>
                </div>
                <div class="col-md-6 perfil-field mb-3">
                    <label>Correo principal</label>
                    <div class="valor">@Model.Email</div>
                </div>
                <div class="col-md-6 perfil-field mb-3">
                    <label>Teléfono móvil</label>
                    <div class="valor">@(Model.PhoneNumber ?? "—")</div>
                </div>
                <div class="col-md-6 perfil-field mb-3">
                    <label>Fecha de nacimiento</label>
                    <div class="valor">@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</div>
                </div>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_ModalExpiracion")
</body>
</html>